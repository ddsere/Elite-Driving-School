<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Point3D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ancPage1" prefHeight="694.0" prefWidth="1360.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.DashBoardController">
    <children>
        <Rectangle arcHeight="0.0" arcWidth="0.0" fill="WHITE" height="689.0" width="1360.0" />

        <Rectangle arcHeight="0.0" arcWidth="0.0" fill="#24246b" height="80.0" strokeType="INSIDE" strokeWidth="0.0" width="1360.0">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="3.0" radius="3.0" width="0.0" />
            </effect>
        </Rectangle>

        <Label layoutX="220.0" layoutY="25.0" style="-fx-text-fill: WHITE;" text="ELITE DRIVING SCHOOL MANAGEMENT SYSTEM" textFill="WHITE">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_RIGHT" layoutX="1080.0" layoutY="23.0" prefHeight="40.0" prefWidth="250.0" spacing="10.0">
            <children>
                <Button fx:id="btnManageUsers" mnemonicParsing="false" onAction="#btnUserRegistrationOnAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: WHITE; -fx-border-radius: 4;" text="Manage Users" textFill="WHITE" />
                <Button alignment="CENTER" layoutX="1200.0" layoutY="25.0" mnemonicParsing="false" onAction="#btnLogOutOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: RED; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: RED; -fx-border-radius: 4;" text="Logout" />
            </children>
        </HBox>

        <VBox layoutX="0.0" layoutY="80.0" prefHeight="576.0" prefWidth="200.0" spacing="0.0" style="-fx-background-color: white;">
            <padding>
                <Insets top="20.0" />
            </padding>

            <children>
                <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 0 0 20 0;">
                    <children>
                        <Label style="-fx-font-size: 30; -fx-text-fill: black;" text="👤" />
                        <Label fx:id="lblUserRole" style="-fx-text-fill: black; -fx-font-size: 14px; -fx-font-weight: bold;" text="User Role" />
                        <Label fx:id="lbTime" style="-fx-text-fill: #8892b0; -fx-font-size: 12px;" />
                    </children>
                </VBox>

                <VBox fx:id="vboxButtons" alignment="TOP_CENTER" prefWidth="200.0" spacing="2.0" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#btnDashBoardOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-radius: 4;" text="Dashboard" />
                        <Button mnemonicParsing="false" onAction="#btnStudentOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Students" />
                        <Button mnemonicParsing="false" onAction="#btnEnrollCourseOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Enroll Course" />
                        <Button fx:id="btnCourse" mnemonicParsing="false" onAction="#btnCourseOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Courses" />
                        <Button fx:id="btnLesson" mnemonicParsing="false" onAction="#btnLessonOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Lessons" />
                        <Button fx:id="btnInstructor" mnemonicParsing="false" onAction="#btnInstructorOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Instructors" />
                        <Button mnemonicParsing="false" onAction="#btnPaymentDetailsOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Payments" />
                        <Button fx:id="course_details" mnemonicParsing="false" onAction="#btnCourseDetailsOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand; -fx-border-color: transparent;" text="Course Details" />
                    </children>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <AnchorPane fx:id="ancMainContainer" layoutX="200.0" layoutY="80.0" prefHeight="550.0" prefWidth="1160.0" style="-fx-background-color: white;">
         <children>
      
                    <VBox fx:id="vbox" layoutX="198.0" layoutY="77.0" prefHeight="386.0" prefWidth="770.0" spacing="20.0" style="-fx-padding: 30;">
                  <children>
            
                          <Label fx:id="lbDateTime" prefHeight="106.0" prefWidth="363.0" style="-fx-text-fill: #8892b0; -fx-font-size: 72px; -fx-font-weight: bold;" text="01:26 AM" textAlignment="RIGHT" />
      
                      <HBox alignment="TOP_CENTER" prefHeight="159.0" prefWidth="1059.0" snapToPixel="false" spacing="50.0">
                          <children>
                              <VBox spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                                  <Label fx:id="lblStudentCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                                  <Label snapToPixel="false" style="-fx-text-fill: black; -fx-font-size: 14px;" text="Students" />
                              </VBox>
      
                                    <VBox spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                                  <Label fx:id="lblCourseCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                                  <Label style="-fx-text-fill: black; -fx-font-size: 14px;" text="Courses" />
                              </VBox>
      
                                    <VBox prefHeight="135.0" prefWidth="136.0" spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                                  <Label fx:id="lblInstructorCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                                  <Label style="-fx-text-fill: black; -fx-font-size: 14px;" text="Instructors" />
                              </VBox>
                          </children>
                     <rotationAxis>
                        <Point3D />
                     </rotationAxis>
                      </HBox>
                  </children>
              </VBox>
         </children></AnchorPane>
    </children>
</AnchorPane>
