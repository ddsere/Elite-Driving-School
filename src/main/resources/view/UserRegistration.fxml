<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.UserRegistrationController">
    <children>

        <Label layoutX="450.0" layoutY="25.0" style="-fx-font-weight: bold;" text="USER MANAGEMENT">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" layoutX="50.0" layoutY="100.0" prefHeight="650.0" prefWidth="1100.0" spacing="20.0">
            <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="450.0" spacing="15.0" style="-fx-padding: 30;">
                <children>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text="User Details">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                    <TextField fx:id="txtUsername" prefHeight="40.0" promptText="Username">
                        <font>
                            <Font size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets top="20.0" />
                        </VBox.margin>
                    </TextField>
                    <PasswordField fx:id="txtPassword" prefHeight="40.0" promptText="Password">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </PasswordField>
                    <PasswordField fx:id="txtConfirmPassword" prefHeight="40.0" promptText="Confirm Password">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </PasswordField>
                    <ComboBox fx:id="cmbRole" prefHeight="40.0" prefWidth="300.0" promptText="Select Role">
                        <VBox.margin>
                            <Insets />
                        </VBox.margin>
                    </ComboBox>
                    <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                        <children>
                            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Add">
                                <font>
                                    <Font size="14.0" />
                                </font>
                                <effect>
                                    <DropShadow color="rgba(100, 255, 218, 0.3)" offsetX="0.0" offsetY="0.0" radius="8.0" />
                                </effect>
                            </Button>
                            <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #dea700; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Update">
                                <font>
                                    <Font size="14.0" />
                                </font>
                                <effect>
                                    <DropShadow color="rgba(166, 196, 255, 0.3)" offsetX="0.0" offsetY="0.0" radius="8.0" />
                                </effect>
                            </Button>
                            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Delete">
                                <font>
                                    <Font size="14.0" />
                                </font>
                                <effect>
                                    <DropShadow color="rgba(231, 76, 60, 0.3)" offsetX="0.0" offsetY="0.0" radius="8.0" />
                                </effect>
                            </Button>
                            <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: grey; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear">
                                <font>
                                    <Font size="14.0" />
                                </font>
                                <effect>
                                    <DropShadow color="rgba(136, 146, 176, 0.3)" offsetX="0.0" offsetY="0.0" radius="8.0" />
                                </effect>
                            </Button>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <VBox prefHeight="600.0" prefWidth="600.0" spacing="10.0" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">
                <children>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text="System Users">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                    <TableView fx:id="userTbl" onMouseClicked="#userTblOnMouseClicked" prefHeight="550.0" prefWidth="600.0">
                        <columns>
                            <TableColumn fx:id="usernameCol" prefWidth="150.0" text="Username" />
                            <TableColumn fx:id="passwordCol" prefWidth="300.0" text="Hashed Password" />
                            <TableColumn fx:id="roleCol" prefWidth="150.0" text="Role" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>
        </HBox>
    </children>
</AnchorPane>
