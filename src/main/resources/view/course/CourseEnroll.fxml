<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1213.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.CourseEnrollController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" height="694.0" style="-fx-fill: WHITE;" width="1200.0" />

        <VBox layoutX="150.0" layoutY="50.0" prefHeight="574.0" prefWidth="900.0" style="-fx-background-color: WHITE; -fx-border-width: 1; -fx-padding: 40;">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="820.0" style="-fx-text-fill: BLACK; -fx-font-weight: bold;" text="COURSE ENROLLMENT">
                    <font>
                        <Font name="System Bold" size="30.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>

                <VBox prefHeight="500.0" prefWidth="820.0" spacing="25.0">
                    <children>
                        <Label style="-fx-text-fill: BLACK; -fx-font-weight: bold; -fx-font-size: 20px;" text="New Enrollment" />

                        <HBox alignment="CENTER_LEFT" spacing="50.0">
                            <children>
                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Student ID *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <TextField fx:id="studentIdTxt" onAction="#onStudentIdTyped" prefHeight="40.0" prefWidth="200.0" promptText="Enter Student ID" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f; -fx-prompt-text-fill: #0d1a2f;" />
                                        <Button fx:id="findStudentBtn" onAction="#onStudentIdTyped" prefHeight="40.0" prefWidth="120.0" style="-fx-font-weight: bold; -fx-cursor: hand;" text="Find Student">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                    </HBox>
                                </VBox>

                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Student Name">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="studentNameTxt" editable="false" prefHeight="40.0" prefWidth="350.0" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f; -fx-prompt-text-fill: #0d1a2f;" />
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="50.0">
                            <children>
                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Select Course *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <ComboBox fx:id="selectCourseCmb" onAction="#onSelectCourse" prefHeight="40.0" prefWidth="350.0" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Course Fee">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="feeTxt" editable="false" prefHeight="40.0" prefWidth="350.0" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f; -fx-prompt-text-fill: #0d1a2f;" />
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="50.0">
                            <children>
                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Enrollment Date *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <DatePicker fx:id="enrollmentDateDp" prefHeight="40.0" prefWidth="350.0" style="-fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>
                                <VBox prefWidth="350.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Duration (Months)">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="durationTxt" editable="false" prefHeight="40.0" prefWidth="350.0" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f; -fx-prompt-text-fill: #0d1a2f;" />
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 30 0 0 0;">
                            <children>
                                <Button fx:id="clearFormBtn" onAction="#onClearFormBtn" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: GREY; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Clear Form" />
                                <Button fx:id="enrollNowBtn" onAction="#onEnrollNowBtn" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: GREEN; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Enroll Now" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" layoutX="13.0" layoutY="632.0" prefHeight="50.0" prefWidth="1200.0" style="-fx-background-color: WHITE; -fx-padding: 0 20;">
            <children>
                <Label style="-fx-text-fill: BLCK;" text="Status: Ready for enrollment">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                </Label>
                <Label fx:id="enrollmentCountLbl" style="-fx-text-fill: BLCK;" text="Total Enrollments: 0" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </children>
</AnchorPane>
