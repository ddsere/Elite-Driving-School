<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1200.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.CourseDetailsController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" height="759.0" style="-fx-fill: WHITE;" width="1200.0" />

        <VBox layoutX="150.0" layoutY="50.0" prefHeight="703.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: WHITE; -fx-padding: 40;">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="820.0" style="-fx-text-fill: BLACK; -fx-font-weight: bold;" text="COURSE ENROLLMENT DETAILS">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <TableView fx:id="tblCourseDetails" prefHeight="550.0" prefWidth="820.0">
                    <columns>
                        <TableColumn fx:id="colStudentName" prefWidth="250.0" style="-fx-font-weight: bold;" text="Student Name" />
                        <TableColumn fx:id="colCourseName" prefWidth="570.0" style="-fx-text-fill: #1a2a43;" text="Enrolled Course" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
      
              <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="1200.0" style="-fx-background-color: WHITE; -fx-padding: 0 20;">
                  <children>
                      <Label style="-fx-text-fill: BLK;" text="Status: Ready">
                          <font>
                              <Font name="System" size="12.0" />
                          </font>
                      </Label>
                      <Label fx:id="totalStudentsLbl" style="-fx-text-fill: BLK;" text="Total Enrollments: 0" textAlignment="RIGHT" HBox.hgrow="ALWAYS">
                          <font>
                              <Font name="System" size="12.0" />
                          </font>
                          <HBox.margin>
                              <Insets right="20.0" />
                          </HBox.margin>
                      </Label>
                  </children>
              </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
