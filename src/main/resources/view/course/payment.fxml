<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1206.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.PaymentController">
    <children>

        <Label layoutX="450.0" layoutY="25.0" style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="PAYMENT MANAGEMENT">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox layoutX="100.0" layoutY="120.0" prefHeight="497.0" prefWidth="1000.0" spacing="25.0">
            <children>
                <HBox prefHeight="550.0" prefWidth="960.0" spacing="20.0" VBox.vgrow="ALWAYS">
                    <VBox prefHeight="550.0" prefWidth="550.0" spacing="10.0" style="-fx-padding: 20;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text="Payment Records">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <TableView fx:id="paymentTbl" prefHeight="500.0" prefWidth="500.0">
                            <columns>
                                <TableColumn fx:id="paymentIdCol" prefWidth="100.0" text="Payment ID" />
                                <TableColumn fx:id="studentIdCol" prefWidth="100.0" text="Student ID" />
                                <TableColumn fx:id="studentNameCol" prefWidth="250.0" text="Student Name" />
                                <TableColumn fx:id="amountCol" prefWidth="150.0" text="Amount (LKR)" />
                                <TableColumn fx:id="dateCol" prefWidth="180.0" text="Payment Date" />
                                <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox prefHeight="550.0" prefWidth="450.0" spacing="15.0" style="-fx-border-width: 1; -fx-padding: 20;">
                        <children>
                            <Label style="-fx-text-fill: BLK; -fx-font-weight: bold; -fx-font-size: 18px;" text="Process Payment" />
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Search Student *" />
                                        <ComboBox fx:id="studentIdCmb" onAction="#onStudentIdSelected" prefHeight="35.0" prefWidth="200.0" promptText="Select Student ID" />
                                    </VBox>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Student Name" />
                                        <TextField fx:id="studentNameTxt" editable="false" prefHeight="35.0" prefWidth="200.0" />
                                    </VBox>
                                </children>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Total Fee (LKR)" />
                                        <TextField fx:id="totalFeeTxt" editable="false" prefHeight="35.0" prefWidth="200.0" />
                                    </VBox>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Already Paid (LKR)" />
                                        <TextField fx:id="alreadyPaidTxt" editable="false" prefHeight="35.0" prefWidth="200.0" />
                                    </VBox>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Balance (LKR)" />
                                        <TextField fx:id="balanceTxt" editable="false" prefHeight="35.0" prefWidth="200.0" />
                                    </VBox>
                                </children>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Payment Amount (LKR) *" />
                                        <TextField fx:id="paymentAmountTxt" onKeyReleased="#onPaymentAmountTyped" prefHeight="35.0" prefWidth="200.0" promptText="0.00" />
                                    </VBox>
                                    <VBox prefWidth="200.0" spacing="5.0">
                                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="Payment Date *" />
                                        <DatePicker fx:id="paymentDateDp" prefHeight="35.0" prefWidth="200.0" />
                                    </VBox>
                                </children>
                            </HBox>
                            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15 0 0 0;">
                                <children>
                                    <Button fx:id="processPaymentBtn" onAction="#onProcessPaymentBtn" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: GREEN; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Process Payment" />
                                    <Button fx:id="generateReceiptBtn" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #dea700; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Generate Receipt" />
                                    <Button fx:id="clearBtn" onAction="#onClearBtn" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: GREY; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" layoutX="6.0" layoutY="650.0" prefHeight="10.0" prefWidth="1200.0" style="-fx-background-color: WHITE; -fx-padding: 0 20;">
            <children>
                <Label fx:id="statusLbl" text="Status: Ready">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                </Label>
                <Label fx:id="totalPaymentsLbl" text="Total Payments: 0" textAlignment="RIGHT" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </children>
</AnchorPane>
