<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1202.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.ManageCourseController">
    <children>

        <VBox layoutX="150.0" layoutY="50.0" prefHeight="593.0" prefWidth="900.0" style="-fx-background-color: WHITE; -fx-border-width: 1; -fx-padding: 40;">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="820.0" style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="COURSE MANAGEMENT">
                    <font>
                        <Font name="System Bold" size="30.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="25.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER" prefHeight="50.0" prefWidth="1100.0" spacing="20.0" style="-fx-padding: 10 20;">
                    <children>
                        <Label text="Search:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="courseSearchTxt" prefHeight="38.0" prefWidth="450.0" promptText="Enter course name or ID" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited" prefHeight="40.0" prefWidth="100.0" style="-fx-cursor: hand; -fx-font-size: 16;" text="Search" />
                    </children>
                </HBox>

                <TableView fx:id="courseTable" onMouseClicked="#courseTableOnMouseClick" prefHeight="450.0" prefWidth="1046.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCourseId" prefWidth="120.0" text="ID" />
                        <TableColumn fx:id="colCourseName" prefWidth="200.0" text="Course Name" />
                        <TableColumn fx:id="colDuration" prefWidth="250.0" text="Duration" />
                        <TableColumn fx:id="colFee" prefWidth="150.0" text="Fee" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" prefHeight="70.0" prefWidth="1100.0" spacing="40.0" style="-fx-padding: 20 0;">
                    <children>
                        <Button fx:id="addBtn" mnemonicParsing="false" onAction="#addBtnOnAction" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: GREEN; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Add New" />
                        <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#updateBtnOnAction" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #dea700; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Update" />
                        <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#deleteBtnOnAction" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: RED; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Delete" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" layoutX="2.0" layoutY="653.0" prefHeight="10.0" prefWidth="1200.0" style="-fx-background-color: WHITE; -fx-padding: 0 20;">
            <children>
                <Label fx:id="lblStatus" style="-fx-text-fill: BLK;" text="Status: Ready">
                    <font>
                        <Font name="System" size="14.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="totalCoursesLbl" style="-fx-text-fill: BLK;" text="Total Courses: 0">
                            <font>
                                <Font name="System" size="14.0" />
                            </font>
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
