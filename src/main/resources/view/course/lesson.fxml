<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1308.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.LessonController">
    <children>

        <VBox layoutX="150.0" layoutY="50.0" prefHeight="621.0" prefWidth="900.0" style="-fx-background-color: WHITE; -fx-padding: 40;">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="820.0" style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="LESSON MANAGEMENT">
                    <font>
                        <Font name="System Bold" size="30.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <VBox prefWidth="820.0" spacing="15.0" style="-fx-background-color: WHITE; -fx-border-width: 1; -fx-padding: 20;">
                    <children>
                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold; -fx-font-size: 18px;" text="Lesson Details">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Lesson ID">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtId" editable="false" prefHeight="40.0" prefWidth="250.0" promptText="Auto-generated" />
                                </VBox>
                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Student ID *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtStudentId" prefHeight="40.0" prefWidth="250.0" promptText="Enter Student ID" />
                                </VBox>
                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Course *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <ComboBox fx:id="cmbCourse" prefHeight="40.0" prefWidth="250.0" />
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Instructor *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <ComboBox fx:id="cmbInstructor" prefHeight="40.0" prefWidth="250.0" />
                                </VBox>

                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Date *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <DatePicker fx:id="DatePiker" prefHeight="40.0" prefWidth="250.0" />
                                </VBox>

                                <VBox prefWidth="250.0" spacing="5.0">
                                    <Label style="-fx-text-fill: BLACK;" text="Start Time *">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtStartTime" prefHeight="40.0" prefWidth="250.0" promptText="HH:MM (24-hour format)" />
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Button fx:id="btnAdd" onAction="#btnSaveOnAction" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: GREEN; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Add Lesson" />
                                <Button fx:id="btnUpdate" onAction="#btnUpdateOnAction" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #dea700; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Reschedule" />
                                <Button fx:id="btnDelete" onAction="#btnDeleteOnAction" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: RED; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Cancel Lesson" />
                                <Button fx:id="btnReset" onAction="#btnResetOnAction" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: GREY; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" text="Clear Form" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefWidth="820.0" spacing="10.0">
                    <children>
                        <Label style="-fx-text-fill: BLK; -fx-font-weight: bold; -fx-font-size: 18px;" text="Scheduled Lessons">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <TableView fx:id="tblLesson" prefHeight="300.0" prefWidth="820.0">
                            <columns>
                                <TableColumn fx:id="colID" prefWidth="120.0" style="-fx-text-fill: #1a2a43; -fx-font-weight: bold;" text="Lesson ID" />
                                <TableColumn fx:id="colCourse" prefWidth="200.0" style="-fx-text-fill: #1a2a43;" text="Course" />
                                <TableColumn fx:id="colInstructor" prefWidth="150.0" style="-fx-text-fill: #1a2a43;" text="Instructor" />
                                <TableColumn fx:id="colDate" prefWidth="120.0" style="-fx-text-fill: #1a2a43;" text="Date" />
                                <TableColumn fx:id="colStartTime" prefWidth="120.0" style="-fx-text-fill: #1a2a43;" text="Start Time" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" style="-fx-text-fill: #1a2a43;" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>

                          <HBox alignment="CENTER_LEFT" layoutX="185.0" layoutY="657.0" prefHeight="26.0" prefWidth="822.0" style="-fx-background-color: WHITE; -fx-padding: 0 20;">
            <children>
                <Label fx:id="lblStatus" style="-fx-text-fill: #8892b0;" text="Status: Ready">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                </Label>
                <Label fx:id="totalLessonsLbl" style="-fx-text-fill: #8892b0;" text="Total Lessons: 0" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </children>
</AnchorPane>
