<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Point3D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ancReceptionistDashboard" prefHeight="934.0" prefWidth="1360.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.DashBoardController">

    <!-- White Background -->
    <Rectangle arcHeight="0.0" arcWidth="0.0" fill="WHITE" height="934.0" width="1360.0" />

    <!-- Top Bar -->
    <Rectangle arcHeight="0.0" arcWidth="0.0" fill="#f8f9fa" height="80.0" strokeType="INSIDE" strokeWidth="0.0" width="1360.0">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.05)" height="3.0" radius="3.0" width="0.0" />
        </effect>
    </Rectangle>

    <!-- App Title -->
    <Label layoutX="30.0" layoutY="25.0" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="ELITE DRIVING SCHOOL">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Top Right Buttons -->
    <HBox alignment="CENTER_RIGHT" layoutX="800.0" layoutY="23.0" prefHeight="40.0" prefWidth="540.0" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#btnLogOutOnAction" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 16; -fx-cursor: hand;" text="Logout" />
    </HBox>

    <!-- Sidebar -->
    <VBox layoutX="0.0" layoutY="80.0" prefHeight="854.0" prefWidth="260.0" spacing="0.0" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets bottom="30.0" left="0" right="0" top="30.0" />
        </padding>

        <!-- User Info -->
        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 30 0;">
            <Label style="-fx-font-size: 40; -fx-text-fill: #2c3e50;" text="👩‍💼" />
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-text-fill: #2c3e50; -fx-font-size: 16px; -fx-font-weight: bold;" text="RECEPTIONIST" />
                <Label fx:id="lbUserRole" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" text="Receptionist" />
            </VBox>
        </VBox>

        <!-- Navigation Menu -->
        <VBox fx:id="vboxButtons" alignment="TOP_CENTER" spacing="8" style="-fx-padding: 0 20px 0 20px;">
            <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 16; -fx-background-radius: 8; -fx-alignment: center-left;" text="Dashboard" />
            <Button fx:id="btnStudent" mnemonicParsing="false" onAction="#btnStudentOnAction" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-alignment: center-left; -fx-font-weight: bold;" text="Students" />
            <Button fx:id="btnEnrollCourse" mnemonicParsing="false" onAction="#btnEnrollCourseOnAction" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-alignment: center-left; -fx-font-weight: bold;" text="Enroll Course" />
            <Button fx:id="btnPaymentDetails" mnemonicParsing="false" onAction="#btnPaymentDetailsOnAction" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-alignment: center-left; -fx-font-weight: bold;" text="Payments" />
        </VBox>

        <VBox VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </VBox>
    </VBox>

    <!-- Main Content Area -->
    <AnchorPane fx:id="ancMainContainer" layoutX="260.0" layoutY="80.0" prefHeight="854.0" prefWidth="1100.0" style="-fx-background-color: #f8f9fa;">
        <children>
            <VBox fx:id="vbox" layoutX="30.0" layoutY="30.0" prefHeight="740.0" prefWidth="1000.0" spacing="30.0" style="-fx-padding: 30;" />
         <VBox fx:id="vbox1" layoutX="208.0" layoutY="87.0" prefHeight="386.0" prefWidth="770.0" spacing="20.0" style="-fx-padding: 30;">
            <children>
               <Label fx:id="lbDateTime" prefHeight="106.0" prefWidth="363.0" style="-fx-text-fill: #8892b0; -fx-font-size: 72px; -fx-font-weight: bold;" text="01:26 AM" textAlignment="RIGHT" />
               <HBox alignment="TOP_CENTER" prefHeight="159.0" prefWidth="1059.0" snapToPixel="false" spacing="50.0">
                  <children>
                     <VBox spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                        <children>
                           <Label fx:id="lblStudentCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                           <Label snapToPixel="false" style="-fx-text-fill: black; -fx-font-size: 14px;" text="Students" />
                        </children>
                     </VBox>
                     <VBox spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                        <children>
                           <Label fx:id="lblCourseCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                           <Label style="-fx-text-fill: black; -fx-font-size: 14px;" text="Courses" />
                        </children>
                     </VBox>
                     <VBox prefHeight="135.0" prefWidth="136.0" spacing="10.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-pref-width: 200; -fx-border-color: rgba(52, 152, 219, 0.5); -fx-border-radius: 8;">
                        <children>
                           <Label fx:id="lblInstructorCount" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                           <Label style="-fx-text-fill: black; -fx-font-size: 14px;" text="Instructors" />
                        </children>
                     </VBox>
                  </children>
                  <rotationAxis>
                     <Point3D />
                  </rotationAxis>
               </HBox>
            </children>
         </VBox>
        </children>
    </AnchorPane>
</AnchorPane>
