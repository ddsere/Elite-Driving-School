<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="694.0" prefWidth="1200.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.elitedrivingschool.controller.ManageInstructorController">
    <children>

        <VBox layoutX="150.0" layoutY="50.0" prefHeight="602.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: WHITE;">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="820.0" style="-fx-text-fill: BLK; -fx-font-weight: bold;" text="INSTRUCTOR MANAGEMENT">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="820.0" spacing="15.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10;">
                    <children>
                        <Label text="Search:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="400.0" promptText="Search by name, specialization or ID" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-font-weight: bold; -fx-cursor: hand;" text="Search" />
                    </children>
                </HBox>

                <HBox prefHeight="323.0" prefWidth="820.0" spacing="30.0">
                    <children>
                        <VBox prefHeight="296.0" prefWidth="355.0" spacing="15.0" style="-fx-padding: 20;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18px;" text="Instructor Details" />

                                <VBox spacing="5.0">
                                    <Label text="Instructor ID *">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtId" editable="false" prefHeight="35.0" prefWidth="350.0" promptText="Auto-generated" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Full Name *">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtName" prefHeight="35.0" prefWidth="350.0" promptText="Enter full name" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                                <VBox prefHeight="41.0" prefWidth="315.0" spacing="5.0">
                                    <Label text="Contact Number *">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtContact" prefHeight="35.0" prefWidth="350.0" promptText="Enter contact number" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Email *">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtEmail" prefHeight="35.0" prefWidth="350.0" promptText="Enter email" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Specialization *">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <ComboBox fx:id="cmbSpecialization" prefHeight="35.0" prefWidth="350.0" promptText="Select specialization" style="-fx-padding: 10; -fx-font-size: 14; -fx-text-fill: #0d1a2f;" />
                                </VBox>

                            </children>
                        </VBox>

                        <VBox prefHeight="375.0" prefWidth="435.0" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Instructor Records">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>

                                <TableView fx:id="tblInstructors" prefHeight="317.0" prefWidth="435.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                                        <TableColumn fx:id="colName" prefWidth="170.0" text="Name" />
                                        <TableColumn fx:id="colContact" prefWidth="150.0" text="Contact" />
                                        <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                                        <TableColumn fx:id="colSpecialization" prefWidth="250.0" text="Specialization" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                  
                          <HBox alignment="CENTER_LEFT" prefHeight="18.0" prefWidth="300.0" style="-fx-padding: 0 20;">
                              <children>
                                  <Label text="Status: Ready">
                                      <font>
                                          <Font name="System" size="12.0" />
                                      </font>
                                  </Label>
                                  <Label fx:id="totalInstructorsLbl" text="Total Instructors: 0" textAlignment="RIGHT" HBox.hgrow="ALWAYS">
                                      <font>
                                          <Font name="System" size="12.0" />
                                      </font>
                                      <HBox.margin>
                                          <Insets right="20.0" />
                                      </HBox.margin>
                                  </Label>
                              </children>
                          </HBox>

                                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 15 0 0 0;">
                                    <children>
                                        <Button fx:id="btnAdd" onAction="#btnSaveOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: GREEN; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Add" />
                                        <Button fx:id="btnUpdate" onAction="#btnUpdateOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #dea700; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Update" />
                                        <Button fx:id="btnDelete" onAction="#btnDeleteOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: RED; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Delete" />
                                        <Button fx:id="btnReset" onAction="#btnResetOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: GREY; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-cursor: hand;" text="Reset" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>

    <effect>
        <DropShadow />
    </effect>
</AnchorPane>
